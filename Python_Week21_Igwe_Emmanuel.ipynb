# 1. The Toy Box (Our Starting Variables)
my_allowance = 10  # You start with 10 dollars!


# 2. The Helpful Robot (Our Functions)
def show_allowance():
    """This robot checks how many dollars you have."""
    print(f"\n[💰] You have {my_allowance} dollars in your piggy bank!")


def buy_sticker():
    """This robot lets you spend 2 dollars on a sticker."""
    global my_allowance
    if my_allowance >= 2:
        my_allowance = my_allowance - 2
        print("\n[⭐] Yay! You bought a shiny sticker for 2 dollars!")
    else:
        print("\n[😢] Oh no! You don't have enough dollars for a sticker.")


# 3. The Game Loop (Our Loop)
playing = True

while playing == True:
    # Show the menu choices
    print("\n--- MAGIC BANK MENU ---")
    print("Press 1 to check your money")
    print("Press 2 to buy a sticker")
    print("Press 3 to close the toy box")

    # Ask the user what they want to do
    choice = input("What do you want to do? (Type 1, 2, or 3): ")

    # Figure out what button was pressed
    if choice == "1":
        show_allowance()
    elif choice == "2":
        buy_sticker()
    elif choice == "3":
        print("\n[👋] Closing the box. Bye-bye!")
        playing = False  # This stops the loop!
    else:
        print("\n[❓] Oops! That's not a button on our machine. Try again!")